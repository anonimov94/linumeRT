#!/bin/bash
# Uruchamia `linumert` ze skrótu na pulpicie; przy błędzie pokazuje okno terminala z końcem dziennika.
# Model-Author: Claude · 2026-10-25. NIEZWERYFIKOWANE NA SPRZĘCIE.
log="$HOME/.linumert-gui.log"
/usr/local/bin/linumert "$@" >"$log" 2>&1
rc=$?
if [ "$rc" -ne 0 ]; then
    exec xfce4-terminal --hold --title "linumeRT: błąd ($rc)" -e \
        "sh -c 'echo \"linumert $* — kod wyjścia $rc, dziennik: $log\"; echo; tail -n 60 \"$log\"'"
fi
