( Przygotówka 150 x 150 x 30 na stole, zero G54 = lewy przedni róg wierzchu )
;@STOCK BOX X150 Y150 Z30 ORIGIN=TOP_FRONT_LEFT OFFSET=G54 MAT="aluminium"
G21 G90 G17 G40 G49 G80 G54 G94
( 1. planowanie głowicą 50 mm, 0,5 mm )
G53 G0 Z0
T5 M6
G43 H5
S6000 M3
G0 Z10
G0 X-30 Y15
G1 Z-0.5 F400
G1 X180 F1200
G1 Y55
G1 X-30
G1 Y95
G1 X180
G1 Y135
G1 X-30
G0 Z10
( 2. kieszeń 70 x 50, głębokość 6 mm w trzech warstwach, frez 10 mm )
G53 G0 Z0
T2 M6
G43 H2
S12000 M3
G0 X45 Y55
G0 Z2
#<z> = -0.5
o100 while [#<z> GT -6]
  #<z> = [#<z> - 2]
  G1 Z#<z> F300
  #<y> = 55
  o110 while [#<y> LT 95]
    G1 X105 Y#<y> F900
    #<y> = [#<y> + 7]
    G1 Y#<y>
    G1 X45
    #<y> = [#<y> + 7]
    G1 Y#<y>
  o110 endwhile
  G1 X45 Y55
  G1 X105
  G1 Y95
  G1 X45
  G1 Y55
o100 endwhile
G0 Z10
