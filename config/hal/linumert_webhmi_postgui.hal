# linumeRT · WebHMI: piny bramy (python -m linumert_webhmi --linuxcnc --hal) do łańcucha D35
# z config/hal/linumert_hmi_estop.hal. Te same sieci co w linumert_postgui.hal ekranu Qt;
# brama nie ma pinów wrzeciona/wycofania Z ekranu Qt, więc tamten plik do niej nie pasuje.
# Do wykonania pinów bramy (`--postgui`) łańcuch HMI jest otwarty (fail-safe).
# Model-Author: Claude · 2026-11-04. NIEZWERYFIKOWANE NA SPRZĘCIE.

net linumert.hmi.button         linumert.hmi-estop-ok   => lrt_hmi_ok.in-00
net linumert.hmi.heartbeat      linumert.hmi-heartbeat  => watchdog.input-0
net linumert.hmi.wd-enable      linumert.hmi-wd-enable  => watchdog.enable-in
net linumert.hmi.ack            linumert.hmi-ack        => lrt_ack_edge.in
