# SPDX-License-Identifier: GPL-2.0-or-later
# linumeRT · po starcie ekranu (piny komponentu ekranu `linumert.*`): ręczna zmiana narzędzia (okno QtDragon) i podnoszenie Z przy pauzie.
# Na podstawie qtdragon_postgui.hal z LinuxCNC 2.9 (GPL-2); zmiany: nazwy sygnałów linumert.*,
# bez pętli prędkości wrzeciona (robi to sim_spindle w linumert_sim.hal).
# Model-Author: Claude · sesja 004.

# Wirtualny magazyn potwierdza M6 bez okna ręcznej wymiany fizycznego freza.
# Operator zatwierdza WYMIANA M6 w HMI; LinuxCNC aktualizuje tool-in-spindle.
net linumert.io.tool-change iocontrol.0.tool-change => sim_toolchange.in
net linumert.io.tool-changed sim_toolchange.out => iocontrol.0.tool-changed
net linumert.io.tool-number iocontrol.0.tool-prep-number => hal_manualtoolchange.number

net linumert.spindle.inhibit    linumert.spindle-inhibit => spindle.0.inhibit
net linumert.z.eoffset-clear    linumert.eoffset-clear => axis.z.eoffset-clear
net linumert.z.eoffset-counts   linumert.eoffset-spindle-count => axis.z.eoffset-counts
net linumert.z.eoffset          linumert.eoffset-value <= axis.z.eoffset
setp axis.z.eoffset-enable 1
setp axis.z.eoffset-scale 1.0

# D35: grzyb E-STOP w HMI i sygnał życia ekranu (config/hal/linumert_hmi_estop.hal)
net linumert.hmi.button         linumert.hmi-estop-ok   => lrt_hmi_ok.in-00
net linumert.hmi.heartbeat      linumert.hmi-heartbeat  => watchdog.input-0
net linumert.hmi.wd-enable      linumert.hmi-wd-enable  => watchdog.enable-in
net linumert.hmi.ack            linumert.hmi-ack        => lrt_ack_edge.in
