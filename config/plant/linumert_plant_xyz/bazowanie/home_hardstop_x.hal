# SPDX-License-Identifier: GPL-2.0-or-later
# linumeRT · bazowanie osi X na twardym zderzaku (metoda hardstop, sesja 015) z Plant.
# Dołącz po linumert_plant.hal; w linumert_plant.hal usuń joint.0.home-sw-in z sygnału
# linumert.j0.home-sw. Wymaga modułu lrt_hardstop_home (halcompile --install hal/lrt_hardstop_home.comp).
# Model-Author: Claude · sesja 018. NIEZWERYFIKOWANE NA SPRZĘCIE.
loadrt lrt_hardstop_home count=1
addf lrt-hardstop-home.0 servo-thread
net lrt.x.homing   joint.0.homing => lrt-hardstop-home.0.enable lrt-cia402.0.homing
net lrt.x.torque   lrt-net.0.axis.0.torque => lrt-hardstop-home.0.value
net lrt.x.hs-sw    lrt-hardstop-home.0.home-sw => joint.0.home-sw-in
# 6072h: w LRT-NET v1 bez pola w ramce; lrt-cia402.0.torque-limit gotowy dla ramki v2 / lcec
setp lrt-hardstop-home.0.threshold 180
setp lrt-hardstop-home.0.detect-time 0.02
setp lrt-cia402.0.torque-limit-homing 200
